{% extends "main.twig" %}

{% block content %}
    <section class="hero">
        <div class="container hero__inner">
            <p class="hero__eyebrow">Herbie Website Starter</p>
            <h1 class="hero__title">Your next site starts here.</h1>
            <p class="hero__text">Pages, a blog, five themes, search and a contact form — all in plain Markdown and Twig.</p>
            <div class="hero__actions">
                <a class="button" href="{{ url_rel('getting-started') }}">Get started</a>
                <a class="button button--outline" href="{{ url_rel('blog') }}">Read the blog</a>
            </div>
        </div>
    </section>

    <div class="container page-section">
        <div class="lead content">
            {{ content.default|raw }}
        </div>

        <div class="card-grid">
            <section class="card">
                {{ content.left|raw }}
            </section>
            <section class="card">
                {{ content.right|raw }}
            </section>
        </div>

        <section class="content callout">
            {{ content.footer|raw }}
        </section>
    </div>
{% endblock %}
