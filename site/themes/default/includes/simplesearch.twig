<section class="widget widget--search">
    <h2 class="widget__title">Search this site</h2>
    <form class="simplesearch" action="{{ url_rel('search') }}" method="get" role="search">
        <label class="visually-hidden" for="sidebar-search">Search term</label>
        <input id="sidebar-search" type="search" name="query" placeholder="Search website...">
        <button type="submit" aria-label="Search">Search</button>
    </form>
</section>
