{% set authorRoute = 'blog/author/' ~ post.author_id %}
{% set author = site.data.authors[post.author_id] ?? null %}
<article class="post-card">
    <p class="post-card__meta">
        <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|date('M j, Y') }}</time>
        {% if author %}<span class="post-card__sep">&middot;</span> by <a href="{{ url_rel(authorRoute) }}">{{ author.title }}</a>{% endif %}
    </p>
    <h3 class="post-card__title">{{ link_page(post.route, post.title) }}</h3>
    {% if post.abstract %}<p class="post-card__abstract">{{ post.abstract }}</p>{% endif %}
    <div class="post-card__footer">
        {% for category in post.categories %}
            <a class="pill" href="{{ url_rel('blog/category/' ~ category|lower) }}">{{ category }}</a>
        {% endfor %}
        {% for tag in post.tags %}
            <a class="pill pill--tag" href="{{ url_rel('blog/tag/' ~ tag) }}">#{{ tag }}</a>
        {% endfor %}
    </div>
</article>
