{% extends "main.twig" %}

{% block content %}
    {% set posts = query(site.page_list).where('type=post') %}
    {% if page.filter_field and page.filter_value %}
        {% set posts = posts.where({(page.filter_field): page.filter_value}) %}
    {% endif %}
    {% set pagination = posts.order('-date').paginate(6) %}
    {% set posts = pagination.items %}

    <div class="container page-section">
        <div class="layout-content">
            <div class="content">
                {{ content.default|raw }}

                {% if posts %}
                    <div class="archive-list">
                        {% for post in posts %}
                            {% set year = post.date|date('Y') %}
                            {% if loop.first or year != posts[loop.index0 - 1].date|date('Y') %}
                                <h2 class="archive-list__year">{{ year }}</h2>
                            {% endif %}
                            <article class="archive-item">
                                <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|date('M j') }}</time>
                                <div>
                                    <h3>{{ link_page(post.route, post.title) }}</h3>
                                    {% if post.abstract %}<p>{{ post.abstract }}</p>{% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <p>No posts found.</p>
                {% endif %}

                {{ include('includes/pagination.twig') }}

                <p class="content__more">{{ link_page('blog', 'All posts') }} &middot; {{ link_page('blog/feed.xml', 'Atom feed') }}</p>
            </div>
            <aside class="sidebar">
                {{ include('includes/blog-nav.twig') }}
            </aside>
        </div>
    </div>
{% endblock %}
