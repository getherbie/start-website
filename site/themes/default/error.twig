{% extends "main.twig" %}

{% block content %}
    <div class="container page-section">
        <div class="content content--narrow">
            {% if error.code == 404 %}
                <h1>Page not found</h1>
                <p>Oops, something got wrong! The page or resource could not be found.</p>
            {% else %}
                <h1>Server Error</h1>
                <p>An error occurred.</p>
            {% endif %}

            <p><a href="/">Back to the home page</a> &middot; <a href="/index.php/search">Search this site</a></p>

            {% if herbie_debug() %}
                <table class="error-table">
                    <tr><th>Code</th><td>{{ error.code }}</td></tr>
                    <tr><th>Message</th><td>{{ error.message }}</td></tr>
                    <tr><th>File</th><td>{{ error.file }}</td></tr>
                    <tr><th>Line</th><td>{{ error.line }}</td></tr>
                    <tr><th>Trace</th><td><pre>{{ error.traceAsString }}</pre></td></tr>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}
